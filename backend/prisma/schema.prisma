datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ContentType {
  TEXT
  IMAGE
  DIAGRAM
  FLOWCHART
  TABLE
  CASE_STUDY
  VIDEO_REFERENCE
  INTERACTIVE_ACTIVITY
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  IMAGE_BASED
  CASE_BASED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum XPActionType {
  CORRECT_ANSWER
  QUIZ_COMPLETION
  PERFECT_SCORE
  TOPIC_COMPLETION
  UNIT_COMPLETION
  STREAK_BONUS
  BADGE_UNLOCKED
  ADMIN_ADJUSTMENT
}

enum ProgressScope {
  SUBJECT
  UNIT
  TOPIC
  QUIZ
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  attempts   QuizAttempt[]
  progress   UserProgress[]
  xpRecords  XPTransaction[]
  userBadges UserBadge[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Subject {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  units    Unit[]
  progress UserProgress[]

  @@index([status])
}

model Unit {
  id           String        @id @default(uuid())
  subjectId    String
  title        String
  description  String?
  unitNumber   Int
  displayOrder Int           @default(1)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics   Topic[]
  progress UserProgress[]

  @@unique([subjectId, unitNumber])
  @@index([subjectId])
  @@index([status])
}

model Topic {
  id           String        @id @default(uuid())
  unitId       String
  title        String
  description  String?
  displayOrder Int           @default(1)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  unit     Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contents LearningContent[]
  quizzes  Quiz[]
  progress UserProgress[]

  @@index([unitId])
  @@index([status])
}

model LearningContent {
  id           String        @id @default(uuid())
  topicId      String
  title        String
  contentType  ContentType   @default(TEXT)
  body         String        @db.Text
  displayOrder Int           @default(1)
  difficulty   Difficulty    @default(MEDIUM)
  status       ContentStatus @default(DRAFT)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([status])
}

model Quiz {
  id                 String        @id @default(uuid())
  topicId            String
  title              String
  description        String?
  difficulty         Difficulty    @default(MEDIUM)
  duration           Int // duration in minutes
  passingPercentage  Float         @default(50.0)
  maximumAttempts    Int           @default(3)
  negativeMarking    Boolean       @default(false)
  correctMark        Float         @default(1.0)
  incorrectMark      Float         @default(0.0)
  unansweredMark     Float         @default(0.0)
  randomizeQuestions Boolean       @default(false)
  randomizeOptions   Boolean       @default(false)
  status             ContentStatus @default(DRAFT)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
  progress  UserProgress[]

  @@index([topicId])
  @@index([status])
}

model Question {
  id           String       @id @default(uuid())
  quizId       String
  questionText String       @db.Text
  questionType QuestionType @default(SINGLE_CHOICE)
  explanation  String?      @db.Text
  marks        Float        @default(1.0)
  difficulty   Difficulty   @default(MEDIUM)
  displayOrder Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
  answers Answer[]

  @@index([quizId])
}

model Option {
  id           String  @id @default(uuid())
  questionId   String
  optionText   String  @db.Text
  displayOrder Int     @default(1)
  isCorrect    Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([questionId])
}

model QuizAttempt {
  id              String        @id @default(uuid())
  userId          String
  quizId          String
  attemptNumber   Int           @default(1)
  startedAt       DateTime      @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?
  status          AttemptStatus @default(IN_PROGRESS)
  totalQuestions  Int           @default(0)
  answeredCount   Int           @default(0)
  correctCount    Int           @default(0)
  incorrectCount  Int           @default(0)
  unansweredCount Int           @default(0)
  totalMarks      Float         @default(0.0)
  obtainedMarks   Float         @default(0.0)
  percentage      Float         @default(0.0)
  isPassed        Boolean       @default(false)
  timeTakenSec    Int?
  snapshotPassingPercentage Float?
  snapshotCorrectMark       Float?
  snapshotIncorrectMark     Float?
  snapshotUnansweredMark    Float?
  snapshotNegativeMarking   Boolean?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([userId])
  @@index([quizId])
  @@index([status])
}

model Answer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean  @default(false)
  marksAwarded     Float    @default(0.0)
  createdAt        DateTime @default(now())

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model UserProgress {
  id                   String        @id @default(uuid())
  userId               String
  scopeType            ProgressScope
  scopeId              String
  subjectId            String?
  unitId               String?
  topicId              String?
  quizId               String?
  completionPercentage Float         @default(0.0)
  quizzesAttempted     Int           @default(0)
  quizzesCompleted     Int           @default(0)
  averageScore         Float         @default(0.0)
  highestScore         Float         @default(0.0)
  lastActivityAt       DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  quiz    Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId])
  @@index([userId])
  @@index([scopeType, scopeId])
}

model XPTransaction {
  id          String       @id @default(uuid())
  userId      String
  actionType  XPActionType
  amount      Int
  description String
  referenceId String?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  iconUrl     String?
  criteria    Json
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@index([code])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}
